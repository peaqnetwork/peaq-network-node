[toolchain]
# Pinned: Rust 1.96 made undefined wasm symbols a hard link error. The extern "C"
# blocks generated by sp-runtime-interface carry no #[link(wasm_import_module)],
# so the runtime wasm blob fails to link on >= 1.96. 1.95.0 is the newest that works.
channel = "1.95.0"
components = [ "rustfmt", "clippy", "rust-src" ]
targets = [ "wasm32-unknown-unknown" ]
profile = "minimal"
